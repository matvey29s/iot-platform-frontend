#!/bin/sh /etc/rc.common
# Nexus IoT Platform hardware daemon (ADC -> module type -> pins, system metrics)
START=94
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/nexusd -c /etc/nexus/nexus.conf
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
